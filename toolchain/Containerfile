# Digest-pinned Rust port toolchain. BASE_IMAGE must be repository@sha256:<64hex>.
#
# The framework is vendored as plain source into /opt/recomp/lib by
# `scripts/coordinator.sh image`, which clones the revision pinned in
# recomp.toml [toolchain].framework_rev into the build context. `recomp` has no
# third-party dependencies, so the image needs no wheels, no pip and no network.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
LABEL org.opencontainers.image.source="https://github.com/pickles976/sage-recomp"

COPY guest /opt/recomp/guest
COPY plugins /opt/recomp/plugins
COPY framework/recomp /opt/recomp/lib/recomp

ENV RECOMP_GUEST_ROOT=/opt/recomp/guest \
    PYTHONPATH=/opt/recomp/lib \
    PYTHONDONTWRITEBYTECODE=1

# Firecracker exits on a kernel reboot, not Linux's power-off halt loop. The
# project-owned PID 1 wrapper only changes that final shutdown command.
RUN printf '#!/bin/sh\nPYTHONPATH=/opt/recomp/lib exec /usr/bin/python3 -m recomp "$@"\n' > /usr/local/bin/recomp \
    && printf '#!/bin/sh\nPYTHONPATH=/opt/recomp/lib exec /usr/bin/python3 /opt/recomp/guest/init.py "$@"\n' \
       > /usr/local/bin/recomp-guest \
    && chmod 0755 /usr/local/bin/recomp /usr/local/bin/recomp-guest \
    && ln -sf /usr/bin/python3 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/recomp-guest /usr/bin/recomp-guest \
    && ln -sf /usr/local/rustup/toolchains/1.96.0-x86_64-unknown-linux-gnu/bin/rustc /usr/bin/rustc \
    && useradd --create-home --uid 1000 recomp \
    && /usr/local/bin/recomp --help >/dev/null

USER recomp:recomp
WORKDIR /workspace
ENV PATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin
ENTRYPOINT ["recomp"]
CMD ["--help"]
