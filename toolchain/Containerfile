# Digest-pinned Rust recovery toolchain. BASE_IMAGE must be
# repository@sha256:<64hex>; every Python artifact is copied in as a wheel.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
LABEL org.opencontainers.image.source="https://github.com/pickles976/sage-recomp"

COPY wheels /opt/recomp/wheels
COPY guest /opt/recomp/guest
COPY plugins /opt/recomp/plugins

# Debian's system Python intentionally omits ensurepip. Put the pinned pip wheel
# on `sys.path`, then install exclusively from the offline wheelhouse.
RUN PYTHONPATH=/opt/recomp/wheels/pip-25.3-py3-none-any.whl \
      python3 -m pip install \
      --break-system-packages --no-index --no-cache-dir --find-links /opt/recomp/wheels \
      recomp==0.1.1 unicorn==2.1.4 \
    && ln -sf /usr/bin/python3 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/recomp-guest /usr/bin/recomp-guest \
    && ln -sf /usr/local/rustup/toolchains/1.96.0-x86_64-unknown-linux-gnu/bin/rustc /usr/bin/rustc \
    && useradd --create-home --uid 1000 recomp \
    && rm -rf /opt/recomp/wheels

USER recomp:recomp
WORKDIR /workspace
ENV RECOMP_TARGET=/recomp/target \
    RECOMP_GUEST_ROOT=/opt/recomp/guest \
    PATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin
ENTRYPOINT ["recomp"]
CMD ["--help"]
